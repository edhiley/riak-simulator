{
  "name": "riak-sim-web-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm": "cd .. && docker build -f wasm/Dockerfile -o web/src/wasm/pkg .",
    "tokens": "tsx scripts/make-tokens.ts",
    "lint:design": "node scripts/lint-design.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json && node scripts/lint-design.mjs",
    "test": "node --test --experimental-strip-types src/lib/*.test.ts",
    "dev": "vite",
    "build": "npm run check && npm run licenses && vite build",
    "preview": "vite preview",
    "licenses": "node scripts/third-party.mjs"
  },
  "devDependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tsconfig/svelte": "^5.0.9",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.6",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@fontsource-variable/roboto-flex": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@lucide/svelte": "1.71.0",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1"
  },
  "license": "Apache-2.0"
}
